# LinkedIn MCP Server - Environment Variables
# Copy this file to .env and fill in your actual values

# LinkedIn API Access Token
# Get this from: https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Your LinkedIn Person URN (optional, will be auto-detected if not provided)
# Format: urn:li:person:ABC123
LINKEDIN_PERSON_URN=

# Post visibility (PUBLIC, CONNECTIONS, ONLY_ME)
LINKEDIN_DEFAULT_VISIBILITY=PUBLIC
