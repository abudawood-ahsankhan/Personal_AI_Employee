# Odoo MCP Server - Environment Variables
# Copy this file to .env and fill in your actual values

# Odoo Community Edition Configuration
# Get these from your Odoo installation

# Odoo URL (local or cloud)
ODOO_URL=http://localhost:8069

# Database name
ODOO_DATABASE=odoo

# Admin username
ODOO_USERNAME=admin

# Admin password
ODOO_PASSWORD=admin

# API Key (optional, for enhanced security)
ODOO_API_KEY=
