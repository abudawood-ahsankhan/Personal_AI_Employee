# Personal AI Employee - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ===========================================
# BRONZE TIER (No external credentials needed)
# ===========================================
# The File System Watcher works without any API credentials.
# Just set the paths below.

# Path to your Obsidian vault (absolute path)
VAULT_PATH=/path/to/your/AI_Employee_Vault

# Path to the drop folder for file watcher
DROP_FOLDER=/path/to/your/Drop

# ===========================================
# SILVER TIER (For future Gmail integration)
# ===========================================
# Uncomment and fill these when implementing Gmail Watcher

# Gmail API Credentials (from Google Cloud Console)
# GMAIL_CLIENT_ID=your_client_id_here
# GMAIL_CLIENT_SECRET=your_client_secret_here
# GMAIL_REDIRECT_URI=http://localhost:8080
# GMAIL_TOKEN_FILE=./tokens/gmail_token.json

# ===========================================
# SILVER TIER (For future WhatsApp integration)
# ===========================================
# Uncomment and fill these when implementing WhatsApp Watcher

# WhatsApp Web session storage path
# WHATSAPP_SESSION_PATH=/secure/path/for/session

# ===========================================
# GOLD TIER (For future Odoo/banking integration)
# ===========================================
# Uncomment and fill these when implementing accounting features

# Odoo ERP Credentials
# ODOO_URL=https://your-odoo-instance.com
# ODOO_DATABASE=your_database_name
# ODOO_API_KEY=your_api_key_here

# Bank API Credentials (if applicable)
# BANK_API_URL=https://api.yourbank.com
# BANK_API_TOKEN=your_bank_token_here

# ===========================================
# GENERAL SETTINGS
# ===========================================

# Development mode (prevents real external actions)
DEV_MODE=true

# Dry run mode (logs actions without executing)
DRY_RUN=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Check interval for watchers (seconds)
CHECK_INTERVAL=30

# Maximum actions per hour (rate limiting)
MAX_ACTIONS_PER_HOUR=60

# ===========================================
# OLLAMA LOCAL LLM CONFIGURATION
# ===========================================
# For running local AI models without API costs

# Ollama server URL (default is local)
OLLAMA_HOST=http://localhost:11434

# Model name to use (qwen3, qwen2.5, llama3.2, mistral, etc.)
OLLAMA_MODEL=qwen2.5

# Context window size (default: 4096)
OLLAMA_NUM_CTX=4096

# Temperature for responses (0.0-1.0, default: 0.7)
OLLAMA_TEMPERATURE=0.7

# ===========================================
# QWEN-AGENT FRAMEWORK CONFIGURATION
# ===========================================
# Free open-source agent framework for building AI employees

# Use local Ollama models (no API costs)
QWEN_AGENT_MODEL=qwen2.5
QWEN_AGENT_SERVER=http://localhost:11434/v1
QWEN_AGENT_API_KEY=EMPTY
